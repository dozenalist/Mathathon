import OAI.MeasureTheory.CompactFactors.RelativeProducts
open Lean Elab Command

/-- auxiliary constants generated by the elaborator (numbering depends on preceding declarations) -/
def isAux (n : Name) : Bool :=
  n.components.any fun c => match c with
    | .str _ s => s.startsWith "_proof_" || s.startsWith "_auxLemma"
    | _ => false

def auxConsts (e : Expr) : Array Name :=
  e.foldConsts #[] fun n acc => if isAux n then acc.push n else acc

def normAux (e : Expr) : Expr :=
  e.replace fun
    | .const n ls => if isAux n then some (.const `AUX ls) else none
    | _ => none

elab "#auxcheck " id:ident : command => do
  let env ← getEnv
  let n := id.getId
  let some ci := env.find? n | throwError "not found {n}"
  let some v := ci.value? | throwError "no value {n}"
  let auxs := auxConsts v
  let mut hs : Array UInt64 := #[]
  for a in auxs do
    match env.find? a with
    | some ai => hs := hs.push (normAux ai.type).hash
    | none => hs := hs.push 0
  let sorted := hs.qsort (· < ·)
  logInfo m!"AUXCHECK {n} type={(normAux ci.type).hash} raw={v.hash} norm={(normAux v).hash} nAux={auxs.size} auxTypes={sorted.toList} auxNames={auxs.toList}"

#auxcheck OAI.EuclideanFiveColor.BoundedMeasurable.Family.avg
#auxcheck OAI.EuclideanFiveColor.BoundedMeasurable.Family.l2Linear
#auxcheck OAI.EuclideanFiveColor.BoundedMeasurable.Family.toL2
