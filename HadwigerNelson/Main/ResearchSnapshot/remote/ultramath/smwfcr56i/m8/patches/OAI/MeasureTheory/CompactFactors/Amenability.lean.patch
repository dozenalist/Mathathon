+/-- For a probability measure, `EventuallyConst s (ae μ)` forces `s` to be a.e. everything or
+a.e. nothing: in this Mathlib version `Filter.EventuallyConst f l` means `(map f l).Subsingleton`,
+i.e. some `l`-set has subsingleton image, and for `s : Set X` that image is `{⊤}`, `{⊥}` or `∅`. -/
+lemma ae_or_ae_not_of_eventuallyConst {X : Type*} [MeasurableSpace X] {μ : Measure X}
+    {s : Set X} (h : EventuallyConst s (ae μ)) :
+    (∀ᵐ x ∂μ, x ∈ s) ∨ (∀ᵐ x ∂μ, x ∉ s) := by
+  classical
+  obtain ⟨u, hu, hus⟩ := h
+  have hu1 : s ⁻¹' u ∈ ae μ := hu
+  have hu' : μ (s ⁻¹' u)ᶜ = 0 := mem_ae_iff.mp hu1
+  rcases Set.eq_empty_or_nonempty (s ⁻¹' u) with hemp | hne
+  · left
+    rw [ae_iff]
+    refine measure_mono_null ?_ hu'
+    intro y hy hyu
+    rw [hemp] at hyu
+    exact hyu
+  · obtain ⟨x, hx⟩ := hne
+    have hxA : s x ∈ u := hx
+    by_cases hxs : x ∈ s
+    · left
+      rw [ae_iff]
+      refine measure_mono_null ?_ hu'
+      intro y hy hyu
+      have h1 : s y = s x := hus hyu hxA
+      exact hy (Eq.mp h1.symm hxs)
+    · right
+      rw [ae_iff]
+      refine measure_mono_null ?_ hu'
+      intro y hy hyu
+      have h1 : s y = s x := hus hyu hxA
+      have hy' : y ∈ s := by simpa using hy
+      exact hxs (Eq.mp h1 hy')
