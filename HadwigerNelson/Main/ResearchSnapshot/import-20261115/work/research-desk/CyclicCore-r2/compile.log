        (∀ (n : ℕ), FiveCenter c (yn n)) →
          FiveCenter c x → Tendsto yn atTop (𝓝 x) → (∀ (n : ℕ), yn n ≠ x) → (∀ (n : ℕ), ‖yn n - x‖ < 2) → False
