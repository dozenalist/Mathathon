+lemma eventuallyConst_set_iff {X₀ : Type*} [MeasurableSpace X₀] {μ₀ : Measure X₀}
+    {s : Set X₀} :
+    EventuallyConst s (ae μ₀) ↔ (∀ᵐ x ∂μ₀, x ∈ s) ∨ (∀ᵐ x ∂μ₀, x ∉ s) := by
+  classical
+  constructor
+  · intro h
+    obtain ⟨u, hu, hus⟩ := h
+    have hu1 : s ⁻¹' u ∈ ae μ₀ := hu
+    have hu' : μ₀ (s ⁻¹' u)ᶜ = 0 := mem_ae_iff.mp hu1
+    rcases Set.eq_empty_or_nonempty (s ⁻¹' u) with hemp | hne
+    · left
+      rw [ae_iff]
+      refine measure_mono_null ?_ hu'
+      intro y hy hyu
+      rw [hemp] at hyu
+      exact hyu
+    · obtain ⟨x, hx⟩ := hne
+      have hxA : s x ∈ u := hx
+      by_cases hxs : x ∈ s
+      · left
+        rw [ae_iff]
+        refine measure_mono_null ?_ hu'
+        intro y hy hyu
+        have h1 : s y = s x := hus hyu hxA
+        exact hy (Eq.mp h1.symm hxs)
+      · right
+        rw [ae_iff]
+        refine measure_mono_null ?_ hu'
+        intro y hy hyu
+        have h1 : s y = s x := hus hyu hxA
+        have hy' : y ∈ s := by simpa using hy
+        exact hxs (Eq.mp h1 hy')
+  · rintro (hs | hs)
+    · refine ⟨(fun x => x ∈ s) '' {x | x ∈ s}, Filter.image_mem_map hs, ?_⟩
+      rintro p ⟨x, hx, rfl⟩ q ⟨y, hy, rfl⟩
+      exact propext ⟨fun _ => hy, fun _ => hx⟩
+    · refine ⟨(fun x => x ∈ s) '' {x | x ∉ s}, Filter.image_mem_map hs, ?_⟩
+      rintro p ⟨x, hx, rfl⟩ q ⟨y, hy, rfl⟩
+      exact propext ⟨fun h => absurd h hx, fun h => absurd h hy⟩
+
