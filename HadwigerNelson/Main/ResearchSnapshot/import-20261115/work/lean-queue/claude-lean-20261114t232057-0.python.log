          b = a + 3 * sixty →
            ∀ {i j : Fin 5},
              a ∈ fiveSupport c hc x i →
                a ∈ fiveSupport c hc x (i + 1) → b ∈ fiveSupport c hc x j → b ∈ fiveSupport c hc x (j + 1) → False
'OAI.EuclideanFiveColor.five_opposite_contacts_false_from_v2' depends on axioms: [propext, Classical.choice, Quot.sound]
