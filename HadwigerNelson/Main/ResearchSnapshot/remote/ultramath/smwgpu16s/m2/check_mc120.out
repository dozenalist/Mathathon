==============================================================================
H2  sigma strictly decreasing, limits, and sigma(r) < 60 deg for r>1
==============================================================================
  d/dr sigma = -2/(r*sqrt(4*r**2 - 1))
           = -2/(r*sqrt(4*r**2 - 1))
  sign for r>1/2 : -2/(r*sqrt(4*r**2 - 1))
  sigma(1)      (limit) = 60.0000000000 deg
  sigma( 1.0001) = 59.9933848250 deg     (< 60 : True)
  sigma(   1.01) = 59.3460296049 deg     (< 60 : True)
  sigma(    1.1) = 54.0713835788 deg     (< 60 : True)
  sigma(    1.5) = 38.9424412690 deg     (< 60 : True)
  sigma(      3) = 19.1881364537 deg     (< 60 : True)
  sigma(    100) = 0.5729601825 deg     (< 60 : True)
  sigma(1+g) - 60deg, g small:  slope = -66.159467 deg per unit g
     g=    1e-6: 60 - sigma(1+g) = 0.0000661594 deg ; predicted 0.0000661595 deg
     g=    1e-4: 60 - sigma(1+g) = 0.0066151750 deg ; predicted 0.0066159467 deg
     g=    0.01: 60 - sigma(1+g) = 0.6539703951 deg ; predicted 0.6615946745 deg
     g=     0.1: 60 - sigma(1+g) = 5.9286164212 deg ; predicted 6.6159467451 deg

