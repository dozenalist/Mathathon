RR127.Shift.sum_map_add : ∀ (l : List Nat) (c : Nat), (List.map (fun x => x + c) l).sum = l.sum + c * l.length
RR127.Shift.addStair_map_add : ∀ (l : List Nat) (c : Nat),
  RR127.addStair (List.map (fun x => x + c) l) = List.map (fun x => x + c) (RR127.addStair l)
RR127.Shift.map_add_sub_cancel : ∀ (l : List Nat) (c : Nat), List.map (fun x => x - c) (List.map (fun x => x + c) l) = l
RR127.Shift.map_sub_add_of_le : ∀ (l : List Nat) (c : Nat),
  (∀ (x : Nat), x ∈ l → c ≤ x) → List.map (fun x => x + c) (List.map (fun x => x - c) l) = l
RR127.Shift.subStair_addStair_map_sub : ∀ (l : List Nat) (c : Nat),
  RR127.subStair (List.map (fun x => x - c) (RR127.addStair l)) = List.map (fun x => x - c) l
RR127.Shift.length_shiftT : ∀ (l : List Nat), (RR127.Shift.shiftT l).length = l.length
RR127.Shift.length_shiftInv : ∀ (l : List Nat), (RR127.Shift.shiftInv l).length = l.length
@RR127.Shift.sum_shiftT : ∀ {lam : List Nat}, RR127.Pos lam → RR127.Gap lam → (RR127.Shift.shiftT lam).sum = lam.sum
@RR127.Shift.mem_shiftT_ge : ∀ {lam : List Nat} (x : Nat), x ∈ RR127.Shift.shiftT lam → lam.length ≤ x
RR127.Shift.mem_shiftT_iff : ∀ (l : List Nat) (x : Nat),
  x ∈ RR127.Shift.shiftT l ↔ ∃ y, y ∈ RR127.subStair l ∧ x = y + l.length
RR127.Shift.shiftT_entry : ∀ (l : List Nat) (i : Nat),
  (RR127.Shift.shiftT l)[i]? = Option.map (fun x => x + l.length) (RR127.subStair l)[i]?
RR127.Shift.shiftInv_entry : ∀ (l : List Nat) (i : Nat),
  (RR127.Shift.shiftInv l)[i]? = Option.map (fun x => x - l.length) (RR127.addStair l)[i]?
@RR127.Shift.shiftInv_shiftT : ∀ {lam : List Nat},
  RR127.Pos lam → RR127.Gap lam → RR127.Shift.shiftInv (RR127.Shift.shiftT lam) = lam
@RR127.Shift.shiftT_shiftInv : ∀ {b : List Nat},
  (∀ (x : Nat), x ∈ b → b.length ≤ x) → RR127.Shift.shiftT (RR127.Shift.shiftInv b) = b
RR127.Shift.weakDec_map_add : ∀ (l : List Nat) (c : Nat),
  RR127.Shift.WeakDec l → RR127.Shift.WeakDec (List.map (fun x => x + c) l)
RR127.Shift.weakDec_subStair : ∀ (l : List Nat), RR127.Pos l → RR127.Gap l → RR127.Shift.WeakDec (RR127.subStair l)
@RR127.Shift.weakDec_shiftT : ∀ {l : List Nat}, RR127.Pos l → RR127.Gap l → RR127.Shift.WeakDec (RR127.Shift.shiftT l)
RR127.Shift.addStair_pos : ∀ (l : List Nat), RR127.Pos (RR127.addStair l)
RR127.Shift.weakDec_addStair : ∀ (l : List Nat), RR127.Shift.WeakDec l → RR127.Gap (RR127.addStair l)
RR127.Shift.addStair_gt : ∀ (b : List Nat) (c : Nat),
  (∀ (x : Nat), x ∈ b → c ≤ x) → ∀ (y : Nat), y ∈ RR127.addStair b → c < y
RR127.Shift.pos_map_sub : ∀ (l : List Nat) (c : Nat),
  (∀ (y : Nat), y ∈ l → c < y) → RR127.Pos (List.map (fun x => x - c) l)
RR127.Shift.gap_map_sub : ∀ (l : List Nat) (c : Nat),
  RR127.Gap l → (∀ (y : Nat), y ∈ l → c ≤ y) → RR127.Gap (List.map (fun x => x - c) l)
@RR127.Shift.shiftInv_pos : ∀ {b : List Nat}, (∀ (x : Nat), x ∈ b → b.length ≤ x) → RR127.Pos (RR127.Shift.shiftInv b)
@RR127.Shift.shiftInv_gap : ∀ {b : List Nat},
  RR127.Shift.WeakDec b → (∀ (x : Nat), x ∈ b → b.length ≤ x) → RR127.Gap (RR127.Shift.shiftInv b)
RR127.Shift.toD_toB : ∀ (l : RR127.Shift.DGap), RR127.Shift.toD (RR127.Shift.toB l) = l
RR127.Shift.toB_toD : ∀ (b : RR127.Shift.BSmall), RR127.Shift.toB (RR127.Shift.toD b) = b
RR127.Shift.weight_toB : ∀ (l : RR127.Shift.DGap), (RR127.Shift.toB l).val.sum = l.val.sum
RR127.Shift.witness_T_531 : RR127.Shift.shiftT [5, 3, 1] = [3, 3, 3]
RR127.Shift.witness_T_41 : RR127.Shift.shiftT [4, 1] = [3, 2]
RR127.Shift.witness_T_641 : RR127.Shift.shiftT [6, 4, 1] = [4, 4, 3]
RR127.Shift.witness_inv_443 : RR127.Shift.shiftInv [4, 4, 3] = [6, 4, 1]
RR127.Shift.witness_gap_needed : (RR127.Shift.shiftT [1, 3]).sum ≠ [1, 3].sum
RR127.Shift.witness_not_injective : RR127.Shift.shiftT [0] = RR127.Shift.shiftT [1] ∧ [0] ≠ [1]
RR127.Shift.witness_weakDec_needed : ¬RR127.Gap (RR127.Shift.shiftInv [2, 5])
