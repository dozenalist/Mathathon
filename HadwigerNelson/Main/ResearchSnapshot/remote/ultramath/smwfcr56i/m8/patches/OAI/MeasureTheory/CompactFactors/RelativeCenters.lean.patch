 /-- The invariant-function consequence of group-action ergodicity,
 with an individual almost-everywhere identity for each group element. -/
+lemma ae_or_ae_not_of_eventuallyConst {Ω₀ : Type*} [MeasurableSpace Ω₀]
+    {μ₀ : Measure Ω₀} {s : Set Ω₀} (h : EventuallyConst s (ae μ₀)) :
+    (∀ᵐ x ∂μ₀, x ∈ s) ∨ (∀ᵐ x ∂μ₀, x ∉ s) := by
+  classical
+  obtain ⟨u, hu, hus⟩ := h
+  have hu1 : s ⁻¹' u ∈ ae μ₀ := hu
+  have hu' : μ₀ (s ⁻¹' u)ᶜ = 0 := mem_ae_iff.mp hu1
+  rcases Set.eq_empty_or_nonempty (s ⁻¹' u) with hemp | hne
+  · left
+    rw [ae_iff]
+    refine measure_mono_null ?_ hu'
+    intro y hy hyu
+    rw [hemp] at hyu
+    exact hyu
+  · obtain ⟨x, hx⟩ := hne
+    have hxA : s x ∈ u := hx
+    by_cases hxs : x ∈ s
+    · left
+      rw [ae_iff]
+      refine measure_mono_null ?_ hu'
+      intro y hy hyu
+      have h1 : s y = s x := hus hyu hxA
+      exact hy (Eq.mp h1.symm hxs)
+    · right
+      rw [ae_iff]
+      refine measure_mono_null ?_ hu'
+      intro y hy hyu
+      have h1 : s y = s x := hus hyu hxA
+      have hy' : y ∈ s := by simpa using hy
+      exact hxs (Eq.mp h1 hy')
+
